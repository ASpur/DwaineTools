    │   └── os_drivers.dm  # /datum/computer/file/mainframe_program/driver - Hardware device drivers.
    │
    ├── DWAINE Daemons & Virtual Files
    │   ├── filetypes.dm   # /datum/computer/file/user_data (USR), /datum/mainframe2_user_data, /datum/computer/file/document (DOC).
    │   ├── artifact_res.dm# Artifact research and analysis mainframe program.
    │   ├── documents.dm   # Document viewing and editing programs for DOC files.
    │   ├── emailserv.dm   # Mainframe email server daemon.
    │   └── logreader.dm   # Mainframe log reading and filtering utility.
    │
    └── programs/          # DWAINE OS Program Executables
        │
        ├── _program_parent.dm # /datum/computer/file/mainframe_program - Base class for all DWAINE programs.
        │
        ├── os/                # Operating System Core
        │   ├── _os_parent.dm  # Base OS class handling connections, pings, and terminal messages.
        │   ├── bootloader.dm  # Emergency bootloader when the main OS is missing from the memory card.
        │   ├── login.dm       # User login manager (motd, authentication requests).
        │   │
        │   ├── kernel/        # The DWAINE Kernel & Syscalls
        │   │   ├── kernel.dm  # Core kernel managing hardware, users, drivers, and system calls.
        │   │   └── syscalls/  # 22 System Calls (fkill, tfork, tspawn, mount, confget, ulogin, msg_term, etc.).
        │   │
        │   └── shell/         # The Msh Shell & Scripting Engine
        │       ├── shell.dm   # Msh shell handling pipes (pipetemp), script execution, and stack operations.
        │       ├── shell_builtins/ # Builtin commands (echo, if, while, eval, sleep, unset, break, cls, etc.).
        │       └── shell_script_operators/ # Script operators (arithmetic, file checks, logic, stack manip, relational).
        │
        └── utilities/         # Standalone System Utilities (Executed via Shell)
            ├── _utility.dm    # Base utility parent class.
            ├── ls.dm, cd.dm, pwd.dm, mkdir.dm, rm.dm # Filesystem navigation & modification.
            ├── cp.dm, mv.dm, ln.dm, chmod.dm, chown.dm # File manipulation & permissions.
            ├── cat.dm, grep.dm, date.dm, scnt.dm      # Text processing & information.
            └── su.dm, mount.dm, tar.dm, getopt.dm     # System administration & archiving.
