│   └── comm_dish.dm       # Communications dish machinery and long-range networking driver logic.
│
├── Core ThinkDOS Applications
│   ├── bank_rec.dm        # Bank account records database program.
│   ├── codereader.dm      # Barcode and ID card scanner termapp.
│   ├── emailclient.dm     # ThinkDOS email client terminal program.
