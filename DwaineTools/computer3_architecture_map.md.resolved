│   ├── sec_rec.dm         # Security records database program.
│   ├── sniffer.dm         # Network packet sniffer and diagnostic utility.
│   ├── writer.dm          # Text editor and file writer program.
│   ├── textfiles.dm       # /datum/computer/file/text - Basic text file datums.
│   └── smallprogs.dm      # Assorted small termapps and utility programs.
│
└── mainframe2/            # Modern DWAINE OS / TermOS Subsystem
    │
    ├── Mainframe Hardware & PNET Devices
    │   ├── mainframe2.dm  # /obj/machinery/networked/mainframe - DWAINE mainframe hardware & terminal connections.
